# 模型目录见仓库根目录 config/models.json。
# 密钥写在项目根 .env，与 models.json 中 apiKey 环境变量名对应。

# HARNESS_MODEL=deepseek/deepseek-chat
# DEEPSEEK_API_KEY=

HARNESS_HOST=127.0.0.1
HARNESS_PORT=8080
HARNESS_TOKEN=
SANDBOX_URL=http://127.0.0.1:8081
SANDBOX_TOKEN=
NODE_REPL_URL=
AGENT_BROWSER_COMMAND=
HARNESS_AUDIT_LOG=./var/audit.jsonl
