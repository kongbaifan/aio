# ── 访问令牌 ─────────────────────────────────────────────
HARNESS_TOKEN=local-dev-harness
SANDBOX_TOKEN=local-dev-sandbox

# ── 监听地址 ─────────────────────────────────────────────
HARNESS_HOST=127.0.0.1
SANDBOX_HOST=127.0.0.1

# ── 模型 API Key ─────────────────────────────────────────
# config/models.json 里各 provider 的 apiKey 写的是环境变量名，在这里赋值。
# 密钥只应出现在本文件（已被 .gitignore 忽略），不要写回 models.json。
FASTAI_API_KEY=
ZMOON_API_KEY=
DEEPSEEK_API_KEY=

# 可选默认选中（可被工作台下拉覆盖）：
# HARNESS_MODEL=fastai/gpt-5.5

LLM_TIMEOUT_SECONDS=90
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=2

# 可选：自定义 models.json 路径（默认 <项目>/config/models.json）
# HARNESS_MODELS_JSON=

# ── 审计日志 ─────────────────────────────────────────────
# 单文件超过上限就轮转，保留若干份历史。上限设 0 表示不轮转。
HARNESS_AUDIT_MAX_BYTES=5242880
HARNESS_AUDIT_BACKUPS=3

# ── 会话持久化 ───────────────────────────────────────────
# 默认落在 <项目>/var/sessions.db，重启后会话与 token 统计都还在。
# 显式设为空字符串则退回纯内存（重启即丢）。
# HARNESS_SESSION_DB=

# ── 安全护栏 ─────────────────────────────────────────────
# 破坏性工具（写文件、执行代码、打开浏览器）执行前是否需要人工确认。
# 默认开启；关掉等于让模型无人值守地改文件和跑代码。
HARNESS_REQUIRE_TOOL_CONFIRMATION=true

# 单个工具结果进入模型上下文的字符上限，超出部分截断并附「已截断」说明。
# 不限制的话，读一个大文件就会把几 MB 塞进 messages，而且会留在里面参与
# 之后的每一轮，token 成本按轮次翻倍。设 0 表示不截断。
HARNESS_TOOL_CONTEXT_LIMIT=8000

# 可选 MCP 入口（mcp_server.py）是否暴露写工具。
# MCP 没有交互式确认的回传通道，默认只给 list_files / read_file；
# 显式开启才注册 write_file / execute_python，且每次调用记审计。
# HARNESS_MCP_ALLOW_WRITE=false

# ── 浏览器窗口 / 视口（默认 1368x1080）──────────────────
# sandbox 的 /v1/browser/info 与 agent-browser 启动窗口共用这组尺寸。
SANDBOX_BROWSER_WIDTH=1368
SANDBOX_BROWSER_HEIGHT=1080
# agent-browser 也认下面写法（二选一即可）：
# AGENT_BROWSER_VIEWPORT=1368x1080
# AGENT_BROWSER_WIDTH=1368
# AGENT_BROWSER_HEIGHT=1080
# 有头模式显示真实窗口时：
# AGENT_BROWSER_HEADED=1

# ── 沙箱资源上限 ─────────────────────────────────────────
SANDBOX_MAX_SESSION_HISTORY=100
SANDBOX_MAX_CODE_SESSIONS=256
