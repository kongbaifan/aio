{
  "mcpServers": {
    "browser": {
      "type": "streamable-http",
      "url": "http://127.0.0.1:8100/mcp"
    },
    "chrome_devtools": {
      "hidden": true,
      "type": "stdio",
      "command": "/usr/local/bin/chrome-devtools-mcp",
      "args": [
        "--browserUrl",
        "http://127.0.0.1:9222"
      ],
      "prefix": "chrome_devtools"
    }
  }
}
