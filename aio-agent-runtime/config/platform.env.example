# Experimental platform foundation, not a complete production deployment.
# Load explicitly through your service environment; the platform does not read legacy .env.
HARNESS_MODE=platform-production
HARNESS_HOST=127.0.0.1
HARNESS_PORT=8080
PLATFORM_PUBLIC_ORIGIN=https://agent.example.test
# Organization created by scripts/platform/manage_platform.py bootstrap.
PLATFORM_LOGIN_ORG_ID=
PLATFORM_ORGANIZATION_LABEL=Enterprise Agent Workbench
# Absolute built web/platform/dist path; serve Web and API on one origin.
PLATFORM_WEB_DIST=
# Supply separate runtime/migration credentials from approved secret storage.
PLATFORM_DATABASE_URL=
PLATFORM_MIGRATION_DATABASE_URL=
PLATFORM_OIDC_ISSUER=https://identity.example.test/tenant/
PLATFORM_OIDC_CLIENT_ID=
PLATFORM_OIDC_CLIENT_SECRET=
PLATFORM_OIDC_AUTHORIZATION_ENDPOINT=https://identity.example.test/authorize
PLATFORM_OIDC_TOKEN_ENDPOINT=https://identity.example.test/token
PLATFORM_OIDC_JWKS_URI=https://identity.example.test/keys
# No executor fallback. Leave actual execution disabled until its gate is verified.
PLATFORM_MANAGER_URL=
PLATFORM_MANAGER_TOKEN=
PLATFORM_SESSION_TTL=28800
PLATFORM_QUEUE_TTL=900
PLATFORM_RUN_TIMEOUT=600
PLATFORM_LEASE_SECONDS=45
PLATFORM_APPROVAL_TTL=300

# Trusted persistent object root (absolute). Never mount this path into compute cells.
PLATFORM_ARTIFACT_ROOT=
PLATFORM_MAX_UPLOAD_BYTES=8388608
# Manager -> platform authority token, distinct from Worker -> manager token.
PLATFORM_MANAGER_CONTROL_TOKEN=
# Admin may reference only operator-approved origins and credential variable NAMES.
# Inject actual model keys into the Worker only; the API does not require those keys.
PLATFORM_MODEL_ALLOWED_ORIGINS=https://model.example.test
PLATFORM_MODEL_SECRET_ENV_ALLOWLIST=AIO_APPROVED_MODEL_KEY
# Absolute JSON path: {"profiles":[{"id":"python-none","image_digest":"sha256:<64 hex>","max_timeout_seconds":120}]}
# The manager must independently approve the same profile and immutable image digest.
PLATFORM_SANDBOX_PROFILES=
# For profiles containing signed dependency environments: absolute operator public-key JSON.
# No signing private key belongs in API/Worker configuration.
PLATFORM_RUNTIME_TRUST_KEYS=

# Optional dedicated credential-bearing MCP gateway; never a compute executor.
PLATFORM_CONNECTOR_URL=
PLATFORM_CONNECTOR_TOKEN=
# Gateway -> API authority credential, distinct from API/Worker -> gateway.
PLATFORM_CONNECTOR_CONTROL_TOKEN=
# Absolute path to the operator-approved endpoints JSON (same definitions as gateway).
PLATFORM_CONNECTOR_ENDPOINTS=

# Absolute JSON file with separately approved document-parser profiles/image digests.
# Parser profile needs at least a 60-second command timeout; never use the host Python process.
PLATFORM_DOCUMENT_PROFILES=
# Optional archive quarantine/import: explicitly selects a profile already in PLATFORM_SANDBOX_PROFILES.
# API and Worker must receive the same current profile/trust configuration. No archive decoding occurs on either host.
PLATFORM_SKILL_IMPORT_PROFILE=
