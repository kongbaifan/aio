# Worker-specific configuration; no OIDC client secret is required.
HARNESS_MODE=platform-production
PLATFORM_DATABASE_URL=
PLATFORM_WORKER_ORG_ID=
PLATFORM_WORKER_ID=worker-01
PLATFORM_MODEL_ALLOWED_ORIGINS=https://model.example.test
PLATFORM_MODEL_SECRET_ENV_ALLOWLIST=AIO_APPROVED_MODEL_KEY
# Supply the actual key only through approved secret injection, never commit it.
AIO_APPROVED_MODEL_KEY=
PLATFORM_QUEUE_TTL=900
PLATFORM_RUN_TIMEOUT=600
PLATFORM_LEASE_SECONDS=45
PLATFORM_APPROVAL_TTL=300
# Optional verified remote compute manager. No local execution fallback.
PLATFORM_MANAGER_URL=
PLATFORM_MANAGER_TOKEN=
# Same trusted local object backend/root as the API (or future shared storage adapter).
PLATFORM_ARTIFACT_ROOT=
# Optional private MCP gateway. Worker has no vault master key or raw MCP credentials.
PLATFORM_CONNECTOR_URL=
PLATFORM_CONNECTOR_TOKEN=
# Required only when enabling private Skill archive imports. Operator-approved JSON, not user install requests.
PLATFORM_SANDBOX_PROFILES=
PLATFORM_RUNTIME_TRUST_KEYS=
PLATFORM_SKILL_IMPORT_PROFILE=
