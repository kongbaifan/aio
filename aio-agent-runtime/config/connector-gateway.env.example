# Dedicated trusted service, NOT the arbitrary-code compute environment.
CONNECTOR_HOST=127.0.0.1
CONNECTOR_PORT=8082
CONNECTOR_ENDPOINTS_FILE=
CONNECTOR_VAULT_ROOT=
# Base64 of 32 cryptographically random bytes, injected from approved secret storage.
CONNECTOR_VAULT_KEY=
CONNECTOR_SERVICE_TOKEN=
CONNECTOR_CONTROL_ORIGIN=https://agent.example.test
CONNECTOR_CONTROL_TOKEN=
# Optional absolute PEM CA bundle for company-controlled TLS endpoints.
CONNECTOR_CA_FILE=
# Never enable on a production/public service. HTTP loopback verification only.
CONNECTOR_TEST_MODE=0

# OAuth clients are pre-registered by the deployment operator. Only this dedicated namespace is accepted.
# Match client_secret_env in an approved OAuth endpoint profile; never set the actual value in git.
CONNECTOR_OAUTH_CLIENT_SECRET_COMPANY=

# Only for configured stdio endpoints: fixed isolated Manager; no local executable or Docker socket here.
CONNECTOR_STDIO_MANAGER_URL=
# Distinct from the normal compute token and all gateway/control/vault credentials.
# Match SANDBOX_CONNECTOR_TOKEN on the Manager.
CONNECTOR_STDIO_MANAGER_TOKEN=
